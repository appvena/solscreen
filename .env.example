# Claude API (wajib untuk fitur "Minta review AI")
# Buat key di https://console.anthropic.com/ — simpan HANYA di server, jangan di frontend.
ANTHROPIC_API_KEY=
# Opsional. Default: claude-sonnet-5-5. Contoh lain: claude-opus-5-5, claude-haiku-5-5
CLAUDE_MODEL=

# Password aplikasi
# Password awal saat pertama kali jalan (default: 123456). Ganti dari menu Pengaturan → Keamanan.
APP_DEFAULT_PASSWORD=
# Folder penyimpanan password (hash). Di Railway/Render, arahkan ke volume/disk persisten
# (mis. /data) supaya password tidak kembali ke awal setiap redeploy.
DATA_DIR=
# Opsional: secret penandatangan sesi login. Jika kosong, dibuat otomatis.
SESSION_SECRET=
