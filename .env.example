# Claude API (wajib untuk fitur "Minta review AI")
# Buat key di https://console.anthropic.com/ — simpan HANYA di server, jangan di frontend.
ANTHROPIC_API_KEY=
# Opsional. Default: claude-sonnet-5-5. Contoh lain: claude-opus-5-5, claude-haiku-5-5
CLAUDE_MODEL=

# Password aplikasi
# Cara paling simpel (dipakai di Vercel): isi APP_PASSWORD. Ganti = edit nilai ini lalu redeploy.
APP_PASSWORD=
# Jika APP_PASSWORD kosong dan ada penyimpanan (Redis/file), password awal = APP_DEFAULT_PASSWORD
# (default 123456) dan bisa diganti dari menu Pengaturan → Keamanan.
APP_DEFAULT_PASSWORD=
# Folder penyimpanan password (hash). Di Railway/Render, arahkan ke volume/disk persisten
# (mis. /data) supaya password tidak kembali ke awal setiap redeploy.
DATA_DIR=
# Opsional: secret penandatangan sesi login. Jika kosong, dibuat otomatis.
SESSION_SECRET=

# Upstash Redis (otomatis diisi Vercel saat Storage → Upstash dihubungkan).
# Jika diisi, password disimpan di Redis, bukan di file.
KV_REST_API_URL=
KV_REST_API_TOKEN=
